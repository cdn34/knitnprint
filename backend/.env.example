APP_ENV=development
HOST=0.0.0.0
PORT=8080
TRUST_PROXY_HEADERS=false
# Required when TRUST_PROXY_HEADERS=true. One AWS ALB hop selects the
# rightmost address that the load balancer observed and appended.
# TRUSTED_PROXY_HOPS=1
WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001
DATABASE_URL=postgres://knitnprint:knitnprint@localhost:5432/knitnprint
# Production migration jobs use a separate schema-owner credential.
# MIGRATION_DATABASE_URL=postgres://knitnprint_migration:...@database/knitnprint
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=eu-west-1
S3_BUCKET=knitnprint-media
S3_ACCESS_KEY_ID=knitnprint
S3_SECRET_ACCESS_KEY=knitnprint-local
MEDIA_PENDING_MAX_HOURS=24
# Production requires a ClamAV-compatible TCP INSTREAM scanner and fails closed.
# MEDIA_SCANNER_ADDRESS=clamav.internal:3310
MEDIA_SCAN_TIMEOUT_SECONDS=10
STOREFRONT_BASE_URL=http://127.0.0.1:3000
# Configure all Stripe values together to enable hosted card checkout.
# Production requires an sk_live_ key and an HTTPS storefront URL.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
PAYMENT_CLEANUP_BATCH=100
NOTIFICATION_BATCH_SIZE=25
# Development uses the in-memory mailbox unless EMAIL_DELIVERY=ses is selected.
# Staging and production always use AWS SES v2 and reject EMAIL_DELIVERY=development.
# Staging also requires a non-empty allowlist of exact test recipient addresses.
# EMAIL_DELIVERY=ses
# EMAIL_FROM=accounts@example.com
# EMAIL_RECIPIENT_ALLOWLIST=owner@example.com,tester@example.com
# AWS_REGION=eu-west-1
# For local development, select an AWS CLI profile instead of committing access keys.
# AWS_PROFILE=knitnprint-development
# SES_CONFIGURATION_SET=
RUST_LOG=knitnprint_api=info,tower_http=info

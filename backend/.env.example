APP_ENV=development
HOST=0.0.0.0
PORT=8080
TRUST_PROXY_HEADERS=false
DATABASE_URL=postgres://knitprint:knitprint@localhost:5432/knitprint
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=eu-west-1
S3_BUCKET=knitprint-media
S3_ACCESS_KEY_ID=knitprint
S3_SECRET_ACCESS_KEY=knitprint-local
MEDIA_PENDING_MAX_HOURS=24
STOREFRONT_BASE_URL=http://127.0.0.1:3000
# Configure all Stripe values together to enable hosted card checkout.
# Production requires an sk_live_ key and an HTTPS storefront URL.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
PAYMENT_CLEANUP_BATCH=100
NOTIFICATION_BATCH_SIZE=25
# Production email delivery uses AWS SES v2 and the standard AWS SDK credential chain.
# EMAIL_FROM=accounts@example.com
# AWS_REGION=eu-west-1
# SES_CONFIGURATION_SET=
RUST_LOG=knitprint_api=info,tower_http=info

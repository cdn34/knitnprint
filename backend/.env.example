APP_ENV=development
HOST=0.0.0.0
PORT=8080
TRUST_PROXY_HEADERS=false
WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001
DATABASE_URL=postgres://knitprint:knitprint@localhost:5432/knitprint
# Production migration jobs use a separate schema-owner credential.
# MIGRATION_DATABASE_URL=postgres://knitprint_migration:...@database/knitprint
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=eu-west-1
S3_BUCKET=knitprint-media
S3_ACCESS_KEY_ID=knitprint
S3_SECRET_ACCESS_KEY=knitprint-local
MEDIA_PENDING_MAX_HOURS=24
# Production requires a ClamAV-compatible TCP INSTREAM scanner and fails closed.
# MEDIA_SCANNER_ADDRESS=clamav.internal:3310
MEDIA_SCAN_TIMEOUT_SECONDS=10
STOREFRONT_BASE_URL=http://127.0.0.1:3000
# Configure PACKLINK_API_KEY to replace flat-rate shipping with live Packlink PRO prices.
# The browser never receives this credential. The remaining values are the default Anadia parcel.
# PACKLINK_API_KEY=
PACKLINK_ORIGIN_COUNTRY=PT
PACKLINK_ORIGIN_POSTAL_CODE=3780-294
PACKLINK_PACKAGE_WIDTH_CM=35
PACKLINK_PACKAGE_LENGTH_CM=50
PACKLINK_PACKAGE_HEIGHT_CM=25
PACKLINK_PACKAGE_WEIGHT_GRAMS=500
# Optional override for Packlink-compatible environments.
# PACKLINK_API_URL=https://api.packlink.com/v1/
# PACKLINK_SOURCE=
# Configure all Stripe values together to enable hosted card checkout.
# Production requires an sk_live_ key and an HTTPS storefront URL.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
PAYMENT_CLEANUP_BATCH=100
NOTIFICATION_BATCH_SIZE=25
# Development uses the in-memory mailbox unless EMAIL_DELIVERY=ses is selected.
# Production always uses AWS SES v2 and rejects EMAIL_DELIVERY=development.
# EMAIL_DELIVERY=ses
# EMAIL_FROM=accounts@example.com
# AWS_REGION=eu-west-1
# For local development, select an AWS CLI profile instead of committing access keys.
# AWS_PROFILE=knitprint-development
# SES_CONFIGURATION_SET=
RUST_LOG=knitprint_api=info,tower_http=info

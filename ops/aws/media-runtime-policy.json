{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "QuarantinedUploadLifecycle",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_MEDIA_BUCKET/uploads-quarantine/*"
    },
    {
      "Sid": "DerivedMediaLifecycle",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_MEDIA_BUCKET/media-public/*"
    }
  ]
}
